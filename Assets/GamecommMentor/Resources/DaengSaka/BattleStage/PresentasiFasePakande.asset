  m_Script: {fileID: 11500000, guid: a96834f499c04c2f895fe1d27f2d702f, type: 3}
  m_Name: PresentasiFasePakande
  m_EditorClassIdentifier:
  opening:
  - portrait: {fileID: 11400000, guid: 3886f6ed97e140dcaa027ca044a6f96b, type: 2}
    speaker: Nenek Pakande
    text: "ENYAH LAH KALIAN DARI GUA LEMBAYUNG!!!!"
  afterSummon:
  - portrait: {fileID: 11400000, guid: dcb01a4e11094b2ca6380832903a8d97, type: 2}
    speaker: Saka
    text: "Lihat!! Dia memanggil monster tadi."
  - portrait: {fileID: 11400000, guid: 4cdf993bc7bd4fbd9668c47c52cf936c, type: 2}
    speaker: Pacca
    text: "Hati-hati, kita kalahkan dulu monsternya."
  airborne:
  - portrait: {fileID: 11400000, guid: 3886f6ed97e140dcaa027ca044a6f96b, type: 2}
    speaker: Nenek Pakande
    text: "Tangguh juga kalian... Coba tangkap aku di udara."
  - portrait: {fileID: 11400000, guid: 4cdf993bc7bd4fbd9668c47c52cf936c, type: 2}
    speaker: Pacca
    text: "AAAAARGH!!! KENAPA SIH KITA MELAWAN MUSUH TERBANG?"
  - portrait: {fileID: 11400000, guid: 965ad3fbff9c415db64e49846bd244f3, type: 2}
    speaker: Daung
    text: "Tenang, jaga aku dan Baran, kita pasti bisa kalain dia."
  roar: {fileID: 8300000, guid: 2ff95c44cef3584baf9bb82e3855b40e, type: 3}
